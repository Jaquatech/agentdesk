{
  "name": "agentdesk",
  "version": "1.4.0",
  "private": true,
  "description": "Local AI dev team: a planner splits work, worker agents build it, QA reviews it. Runs on your own machine.",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "setup": "npm install && npm run build --workspace web",
    "start": "npm run start --workspace server",
    "demo": "npm run demo --workspace server",
    "demo:reset": "node scripts/demo-reset.mjs",
    "e2e": "playwright test",
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web && npm run typecheck --workspace server",
    "test": "npm test --workspace server && npm test --workspace web",
    "lint": "eslint . --max-warnings 182"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "@ts-morph/common": {
      "minimatch": "^11.0.8"
    }
  }
}
